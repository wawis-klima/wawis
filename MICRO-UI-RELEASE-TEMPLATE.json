{
  "release_mode": "micro-ui",
  "rules": {
    "allowed_changes": "CSS only under src/ or public/",
    "required_check": "WAWIS PR checks / targeted-checks",
    "final_release_runner_required": false,
    "drive_zip_before_merge_required": false,
    "archive_after_merge": true,
    "vercel_deploys": 1
  },
  "flow": [
    "release/vX + CSS change + version metadata",
    "one WAWIS PR checks run",
    "merge to main",
    "one production Vercel deploy",
    "deferred ZIP artifact after merge"
  ]
}
